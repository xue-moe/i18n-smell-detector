{
  "name": "i18n-smell-detector",
  "version": "0.5.0",
  "description": "Find copied locale values, placeholder mismatches, and hardcoded user-visible strings.",
  "type": "module",
  "bin": {
    "i18n-smell-detector": "./bin/i18n-smell-detector.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xue-moe/i18n-smell-detector.git"
  },
  "bugs": {
    "url": "https://github.com/xue-moe/i18n-smell-detector/issues"
  },
  "homepage": "https://github.com/xue-moe/i18n-smell-detector#readme",
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node ./bin/i18n-smell-detector.js check --config ./examples/vue-vite/i18n-smell.config.mjs --fail-on none",
    "check:identical": "node ./bin/i18n-smell-detector.js check-identical --config ./examples/vue-vite/i18n-smell.config.mjs --fail-on none",
    "check:hardcoded": "node ./bin/i18n-smell-detector.js check-hardcoded --config ./examples/vue-vite/i18n-smell.config.mjs --fail-on none",
    "example:basic": "node ./bin/i18n-smell-detector.js check --config ./examples/basic/i18n-smell.config.mjs --fail-on none",
    "audit": "npm audit --audit-level=moderate",
    "check:package": "node ./scripts/check-package.js",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "test": "node --test"
  },
  "keywords": [
    "i18n",
    "l10n",
    "locale",
    "translation",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@vue/compiler-dom": "^3.5.39",
    "@vue/compiler-sfc": "^3.5.39",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "semantic-release": "^25.0.5"
  }
}
